# ==========================================
# Codebase Universe AI - Environment Config
# ==========================================

# Application Environment (development | production | test)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8008
FRONTEND_PORT=5173

# Database (MongoDB)
# If MongoDB is unavailable, the application gracefully uses the local embedded document store
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=codebase_universe

# LLM Provider Configuration
# Supported providers: gemini | openai | ollama | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama:latest

# Security & Sandboxing
MAX_UPLOAD_SIZE_MB=50
ENABLE_TEST_RUNNER=false
WORKSPACE_ROOT=./storage/repos
